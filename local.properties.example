# Bu faylni `local.properties` nomi bilan saqlang (bu fayl machine-specific,
# git'ga qo'shilmaydi). Android Studio'da loyihani birinchi marta ochganingizda
# bu fayl AVTOMATIK yaratiladi — odatda qo'lda to'ldirish shart emas.
#
# sdk.dir — Android SDK joylashgan papka:
#   macOS:   /Users/<foydalanuvchi>/Library/Android/sdk
#   Windows: C:\\Users\\<foydalanuvchi>\\AppData\\Local\\Android\\Sdk
#   Linux:   /home/<foydalanuvchi>/Android/Sdk
#
# flutter.sdk — Flutter SDK joylashgan papka (masalan /Users/<siz>/flutter)

sdk.dir=/path/to/your/Android/sdk
flutter.sdk=/path/to/your/flutter
flutter.versionName=1.0.0
flutter.versionCode=1
